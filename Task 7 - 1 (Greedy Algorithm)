#include <iostream>
#include <vector>
#include <algorithm>
#include <string>
using namespace std;

struct Item {
    string name;
    int price;
};

int main() {
    
    int budget;
    cout << "Enter your shopping budget: ";
    cin >> budget;

    if (budget <= 0) {
        cout << "Budget must be positive. Try again.\n";
        return 0;
    }

    int n;
    cout << "How many items are you considering today? ";
    cin >> n;

    if (n <= 0) {
        cout << "You must have at least one item to consider. Try again.\n";
        return 0;
    }

    vector<Item> items(n);
    cout << "Please enter the name and price of each item.\n\n";

    for (int i = 0; i < n; ++i) {
        cout << "ITEM " << (i + 1) << " NAME: ";
        cin >> items[i].name;
        cout << "ITEM " << (i + 1) << " PRICE: ";
        cin >> items[i].price;

        if (items[i].price <= 0) {
            cout << "Price must be positive. Setting this item price to 1.\n";
            items[i].price = 1;
        }
        cout << "\n";
    }

    sort(items.begin(), items.end(), [](const Item& a, const Item& b) {
        return a.price < b.price;
    });

    vector<Item> chosen;
    int totalCost = 0;

    for (int i = 0; i < n; ++i) {
        if (totalCost + items[i].price <= budget) {
            chosen.push_back(items[i]);
            totalCost += items[i].price;
        } else {
            break;
        }
    }

    cout << "Your budget: " << budget << "\n";

    if (chosen.empty()) {
        cout << "Unfortunately you cannot afford any of the items.\n";
    } else {
        cout << "You can buy " << chosen.size() << " item(s):\n";
        for (size_t i = 0; i < chosen.size(); ++i) {
            cout << "- " << chosen[i].name << " (price: " << chosen[i].price << ")\n";
        }
        cout << "\nTotal cost: " << totalCost << "\n";
        cout << "Remaining budget: " << (budget - totalCost) << "\n";
    }

    return 0;
}
