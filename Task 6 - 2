#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    srand(time(NULL));

    int n;
    cout << "Enter number of coins (n > 2): ";
    cin >> n;

    if (n <= 2) {
        cout << "n must be greater than 2.\n";
        return 0;
    }

    int* coins = new int[n];
    int genuineWeight = 10;

    for (int i = 0; i < n; i++) {
        coins[i] = genuineWeight;
    }

    int fakeIndex = rand() % n;

    bool fakeHeavier = rand() % 2;
    coins[fakeIndex] += (fakeHeavier ? 1 : -1);

    int foundFake = -1;
    bool isHeavier = false;

    for (int i = 0; i < n; i++) {
        if (coins[i] != genuineWeight) {
            foundFake = i;
            isHeavier = (coins[i] > genuineWeight);
            break;
        }
    }

    if (foundFake != -1) {
        cout << "Fake Coin: " << foundFake + 1 << "\n";
        cout << "It's " << (isHeavier ? "Heavier" : "Lighter") << "\n";
    } else {
        cout << "Error: no fake coin found.\n";
    }

    delete[] coins;

    return 0;
}
